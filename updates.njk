---
layout: base.njk
eleventyComputed:
  title: "Updates — All the Agents"
---
<div class="page-header">
  <h1>Updates</h1>
  <p class="page-sub">Newest additions to the catalog first — {{ collections["all-entries"] | size | numFmt }} entries across agents, multiplexers, and SDKs.</p>
</div>

<ul class="upd-list">
  {% set sorted = collections["all-entries"] | sortByAdded %}
  {% for entry in sorted %}
  <li>
    <span class="upd-date">{{ entry.data.date_added | dateFmt }}</span>
    <a href="{{ ('/agents/' ~ entry.data.slug ~ '/') | url }}">{{ entry.data.name }}</a>
    {% if entry.data.category and entry.data.category != "other" %}<span class="badge badge-cat badge-cat-{{ entry.data.category }}">{{ entry.data.category }}</span>{% endif %}
    <span class="upd-maker">{{ entry.data.maker or "" }}</span>
  </li>
  {% endfor %}
</ul>
