---
layout: base.njk
pagination:
  data: collections.agent
  size: 100
  alias: agents
eleventyComputed:
  title: "All Agents — Harness Census"
  extraScripts: |
    <script src="{{ '/js/list-view.js' | url }}"></script>
---
<div class="page-header">
  <h1>All Agents</h1>
  <p class="page-sub">{{ collections.agent | size }} coding agents and harnesses, sorted alphabetically.</p>
</div>

<div class="filter-bar" data-filter-bar data-source="agents-only">
  <input type="search" class="filter-search" data-filter-search placeholder="Filter by name, maker, language…">
  <select data-filter-select data-field="license">
    <option value="">All licenses</option>
  </select>
  <select data-filter-select data-field="maintained">
    <option value="">Any status</option>
    <option value="active">Active</option>
    <option value="dormant">Dormant</option>
    <option value="dead">Dead</option>
    <option value="acquired">Acquired</option>
    <option value="renamed">Renamed</option>
  </select>
  <select data-filter-select data-field="platforms">
    <option value="">All platforms</option>
  </select>
  <select data-filter-sort>
    <option value="name">Sort: Name</option>
    <option value="stars">Sort: Stars</option>
    <option value="released">Sort: Released</option>
  </select>
  <span class="filter-count" data-filter-count></span>
</div>

<div class="card-grid" data-card-grid>
  {% set sorted = agents | sortByName %}
  {% for agent in sorted %}
  <a class="agent-card" href="{{ ('/agents/' ~ agent.data.slug ~ '/') | url }}"
     data-name="{{ agent.data.name }}"
     data-maker="{{ agent.data.maker or '' }}"
     data-license="{{ agent.data.license or '' }}"
     data-maintained="{{ agent.data.maintained or '' }}"
     data-platforms="{{ agent.data.platforms | join(', ') }}"
     data-stars="{{ agent.data.stars or 0 }}"
     data-released="{{ agent.data.first_released or '' }}"
     data-language="{{ agent.data.language or '' }}">
    <div class="card-top">
      <span class="card-name">{{ agent.data.name }}</span>
      {% if agent.data.stars and agent.data.stars != "null" %}<span class="card-stars">★ {{ agent.data.stars | starFmt }}</span>{% endif %}
    </div>
    <p class="card-desc">{% if agent.data.what_makes_it_special %}{{ agent.data.what_makes_it_special | truncate(160) }}{% endif %}</p>
    <div class="card-meta">
      {% if agent.data.maker and agent.data.maker != "null" %}<span>{{ agent.data.maker }}</span><span class="dot">·</span>{% endif %}
      {% if agent.data.license and agent.data.license != "null" %}<span>{{ agent.data.license }}</span><span class="dot">·</span>{% endif %}
      {% if agent.data.maintained and agent.data.maintained != "null" %}<span class="badge badge-status badge-status-{{ agent.data.maintained }}">{{ agent.data.maintained }}</span>{% endif %}
    </div>
  </a>
  {% endfor %}
</div>

<div class="filter-empty" data-filter-empty hidden>No agents match your filters.</div>

{% if pagination.hrefs.length > 1 %}
<div class="pagination">
  {% for href in pagination.hrefs %}
    {% if loop.index0 == pagination.pageNumber %}
    <span class="page-current">{{ loop.index }}</span>
    {% else %}
    <a href="{{ href | url }}">{{ loop.index }}</a>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
