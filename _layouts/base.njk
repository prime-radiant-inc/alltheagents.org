<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <nav class="nav">
    <a href="{{ '/' | url }}" class="nav-logo">Harness Census</a>
    <a href="{{ '/all/' | url }}" class="nav-link">All Agents</a>
    <a href="{{ '/by-license/' | url }}" class="nav-link">By License</a>
    <a href="{{ '/by-platform/' | url }}" class="nav-link">By Platform</a>
    <a href="{{ '/by-maker/' | url }}" class="nav-link">By Maker</a>
    <a href="{{ '/stars/' | url }}" class="nav-link">By Stars</a>
    <a href="{{ '/newest/' | url }}" class="nav-link">Newest</a>
    <a href="{{ '/multiplexers/' | url }}" class="nav-link">Multiplexers</a>
    <a href="{{ '/agent-sdks/' | url }}" class="nav-link">Agent SDKs</a>
  </nav>
  <main class="container">
    {{ content | safe }}
  </main>
  <footer class="footer">
    <p><a href="https://github.com/prime-radiant-inc/harness-census">Harness Census</a> — {{ collections["all-entries"] | size }} entries catalogued · {{ collections.agent | size }} agents · {{ collections.multiplexer | size }} multiplexers · {{ collections["agent-sdk"] | size }} SDKs</p>
  </footer>
  {{ extraScripts | safe }}
</body>
</html>
