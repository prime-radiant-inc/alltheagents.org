<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  {% set navLinks = [
    { url: "/agents/", label: "Agents" },
    { url: "/agent-sdks/", label: "Agent SDKs" },
    { url: "/multiplexers/", label: "Multiplexers" },
    { url: "/updates/", label: "Updates" },
    { url: "/about/", label: "About" }
  ] %}
  <nav class="nav">
    <a href="{{ '/' | url }}" class="nav-logo">All the Agents</a>
    {% for link in navLinks %}
    {% set isActive = page.url == link.url %}
    <a href="{{ link.url | url }}" class="nav-link{% if isActive %} active{% endif %}"{% if isActive %} aria-current="page"{% endif %}>{{ link.label }}</a>
    {% endfor %}
    <div class="nav-search" data-index-url="{{ '/agents.json' | url }}" data-agent-base="{{ '/agents/' | url }}">
      <input type="search" id="nav-search" placeholder="Search the catalog…" autocomplete="off" aria-label="Search the catalog">
      <div class="nav-search-results" id="nav-search-results"></div>
    </div>
  </nav>
  <main class="container">
    {{ content | safe }}
  </main>
  <footer class="footer">
    <p><a href="https://github.com/prime-radiant-inc/alltheagents.org">All the Agents</a> is an open community project maintained by <a href="https://primeradiant.com">Prime Radiant</a>.</p>
    {% if page.url != "/about/" %}
    <p><a href="https://github.com/prime-radiant-inc/alltheagents.org/issues/new/choose" target="_blank" rel="noopener">Add or fix an entry →</a></p>
    {% endif %}
  </footer>
  {{ extraScripts | safe }}
  <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>
  <script src="{{ '/js/nav-search.js' | url }}"></script>
</body>
</html>
