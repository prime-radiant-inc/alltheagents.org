<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  {% set navLinks = [
    { url: "/all/", label: "All Entries" },
    { url: "/by-license/", label: "By License" },
    { url: "/by-platform/", label: "By Platform" },
    { url: "/by-maker/", label: "By Maker" },
    { url: "/stars/", label: "By Stars" },
    { url: "/newest/", label: "Newest" },
    { url: "/multiplexers/", label: "Multiplexers" },
    { url: "/agent-sdks/", label: "Agent SDKs" }
  ] %}
  <nav class="nav">
    <a href="{{ '/' | url }}" class="nav-logo">Harness Census</a>
    {% for link in navLinks %}
    {% set isActive = page.url == link.url %}
    <a href="{{ link.url | url }}" class="nav-link{% if isActive %} active{% endif %}"{% if isActive %} aria-current="page"{% endif %}>{{ link.label }}</a>
    {% endfor %}
  </nav>
  <main class="container">
    {{ content | safe }}
  </main>
  <footer class="footer">
    <p><a href="https://github.com/prime-radiant-inc/harness-census">Harness Census</a> by <a href="https://primeradiant.com">Prime Radiant</a> — {{ collections["all-entries"] | size | numFmt }} entries catalogued · {{ collections.agent | size | numFmt }} agents · {{ collections.multiplexer | size | numFmt }} multiplexers · {{ collections["agent-sdk"] | size | numFmt }} SDKs</p>
  </footer>
  {{ extraScripts | safe }}
</body>
</html>
