---
layout: base.njk
eleventyComputed:
  title: "Multiplexers — Harness Census"
  extraScripts: |
    <script src="{{ '/js/list-view.js' | url }}"></script>
---
<div class="page-header">
  <h1>Agent Multiplexers</h1>
  <p class="page-sub">Tools that orchestrate, manage, or run other coding agent harnesses (Claude Code, Codex, Cursor, etc.). These are not agents themselves — they coordinate agents.</p>
</div>

<div class="filter-bar" data-filter-bar>
  <input type="search" class="filter-search" data-filter-search placeholder="Filter by name, maker, language…">
  <select data-filter-select data-field="license">
    <option value="">All licenses</option>
  </select>
  <select data-filter-select data-field="maintained">
    <option value="">Any status</option>
    <option value="active">Active</option>
    <option value="dormant">Dormant</option>
    <option value="dead">Dead</option>
    <option value="acquired">Acquired</option>
    <option value="renamed">Renamed</option>
  </select>
  <select data-filter-sort>
    <option value="name">Sort: Name</option>
    <option value="stars">Sort: Stars</option>
  </select>
  <select data-filter-pagesize aria-label="Entries per page">
    <option value="25">25 / page</option>
    <option value="50">50 / page</option>
    <option value="100">100 / page</option>
  </select>
  <span class="filter-count" data-filter-count></span>
</div>

<div class="card-grid" data-card-grid>
  {% set sorted = collections.multiplexer | sortByStars %}
  {% for mux in sorted %}
  <a class="agent-card" href="{{ ('/agents/' ~ mux.data.slug ~ '/') | url }}"
     data-name="{{ mux.data.name }}"
     data-maker="{{ mux.data.maker or '' }}"
     data-license="{{ mux.data.license or '' }}"
     data-maintained="{{ mux.data.maintained or '' }}"
     data-stars="{{ mux.data.stars or 0 }}"
     data-language="{{ mux.data.language or '' }}">
    <div class="card-top">
      <span class="card-name">{{ mux.data.name }}</span>
      {% if mux.data.stars and mux.data.stars != "null" %}<span class="card-stars">★ {{ mux.data.stars | starFmt }}</span>{% endif %}
    </div>
    <p class="card-desc">{% if mux.data.what_makes_it_special %}{{ mux.data.what_makes_it_special | truncate(160) }}{% endif %}</p>
    <div class="card-meta">
      {% if mux.data.maker and mux.data.maker != "null" %}<span>{{ mux.data.maker }}</span><span class="dot">·</span>{% endif %}
      {% if mux.data.maintained and mux.data.maintained != "null" %}<span class="badge badge-status badge-status-{{ mux.data.maintained }}">{{ mux.data.maintained }}</span>{% endif %}
    </div>
  </a>
  {% endfor %}
</div>

<div class="filter-empty" data-filter-empty hidden>No multiplexers match your filters.</div>

<div class="pagination" data-pagination></div>
