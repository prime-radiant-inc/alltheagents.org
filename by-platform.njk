---
layout: base.njk
eleventyComputed:
  title: "By Platform — Harness Census"
---
<h1>Coding Agents by Platform</h1>
{% set groups = collections.agent | groupBy("platforms") %}
{% set allKeys = groups | keys %}
{% for key in allKeys %}
  {% set agents = groups[key] %}
  {% if agents and agents.length > 0 %}
  <section class="platform-group">
    <h2>{{ key }} ({{ agents.length }})</h2>
    <table class="agent-table">
      <thead>
        <tr><th>Name</th><th>Maker</th><th>License</th><th>Stars</th></tr>
      </thead>
      <tbody>
        {% set sorted = agents | sortByStars %}
        {% for agent in sorted %}
        <tr>
          <td><a href="{{ ('/agents/' ~ agent.data.slug ~ '/') | url }}">{{ agent.data.name }}</a></td>
          <td>{{ agent.data.maker or "—" }}</td>
          <td>{{ agent.data.license or "—" }}</td>
          <td>{{ agent.data.stars | starFmt }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}
{% endfor %}
